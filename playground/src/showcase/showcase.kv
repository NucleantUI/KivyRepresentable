<Header@BoxLayout>:
    title: ''
    show_back: True
    size_hint_y: None
    height: dp(52)
    padding: dp(8), dp(6)
    spacing: dp(8)
    canvas.before:
        Color:
            rgba: 0.12, 0.13, 0.17, 1
        Rectangle:
            pos: self.pos
            size: self.size
    Button:
        text: '‹ Home'
        size_hint_x: None
        width: dp(90)
        opacity: 1 if root.show_back else 0
        disabled: not root.show_back
        on_release: app.go('home')
    Label:
        text: root.title
        bold: True
        font_size: '20sp'
    Label:
        text: app.clock_text + '   ' + app.fps_text
        size_hint_x: None
        width: dp(150)
        color: 0.6, 0.8, 1, 1

<Card@Button>:
    text_title: ''
    subtitle: ''
    accent: 0.3, 0.6, 1, 1
    markup: True
    text: '[b][size=20sp]{}[/size][/b]\n{}'.format(self.text_title, self.subtitle)
    halign: 'center'
    background_normal: ''
    background_color: 0, 0, 0, 0
    canvas.before:
        Color:
            rgba: 0, 0, 0, 0.6
        BoxShadow:
            pos: self.x + dp(4), self.y + dp(4)
            size: self.width - dp(8), self.height - dp(8)
            offset: 0, -dp(4)
            blur_radius: dp(16)
            border_radius: [dp(14)] * 4
            spread_radius: [dp(-2), dp(-2)]
        Color:
            rgba: self.accent if self.state == 'normal' else [c * 0.7 for c in self.accent[:3]] + [1]
        RoundedRectangle:
            pos: self.x + dp(4), self.y + dp(4)
            size: self.width - dp(8), self.height - dp(8)
            radius: [dp(14)]

<HomeScreen>:
    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: 0.08, 0.09, 0.11, 1
            Rectangle:
                pos: self.pos
                size: self.size
        Header:
            title: 'Kivy on Nucleant'
            show_back: False
        Label:
            size_hint_y: None
            height: dp(60)
            text: 'Kivy, drawn by NucleantUI on Vulkan. Pick a screen.'
            color: 0.75, 0.75, 0.8, 1
        GridLayout:
            cols: 2
            padding: dp(16)
            spacing: dp(12)
            Card:
                text_title: 'Canvas'
                subtitle: 'clock-driven drawing'
                accent: 0.2, 0.5, 0.9, 1
                on_release: app.go('canvas')
            Card:
                text_title: 'Clock & Animation'
                subtitle: 'intervals, once, Animation'
                accent: 0.25, 0.65, 0.35, 1
                on_release: app.go('clock')
            Card:
                text_title: 'Widgets'
                subtitle: 'inputs, spinner, scroll view'
                accent: 0.8, 0.45, 0.2, 1
                on_release: app.go('widgets')
            Card:
                text_title: 'Shader'
                subtitle: 'a fragment shader of its own'
                accent: 0.6, 0.3, 0.8, 1
                on_release: app.go('shader')

<CanvasScreen>:
    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: 0.05, 0.06, 0.1, 1
            Rectangle:
                pos: self.pos
                size: self.size
        Header:
            title: 'Canvas'
        OrbitCanvas:
            id: orbit

<ClockScreen>:
    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: 0.07, 0.1, 0.08, 1
            Rectangle:
                pos: self.pos
                size: self.size
        Header:
            title: 'Clock & Animation'
        BoxLayout:
            orientation: 'vertical'
            padding: dp(20)
            spacing: dp(14)
            Label:
                text: 'schedule_interval(0.1): {} ticks, {:.1f}s'.format(root.ticks, root.elapsed)
                font_size: '18sp'
            Label:
                text: root.once_status
                font_size: '18sp'
                color: (0.5, 1, 0.6, 1) if 'fired' in root.once_status else (1, 0.8, 0.4, 1)
            ProgressBar:
                id: progress
                max: 100
                size_hint_y: None
                height: dp(30)
            Widget:
                id: track
                size_hint_y: None
                height: dp(120)
                canvas:
                    Color:
                        rgba: 0.2, 0.3, 0.25, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(60)]
                Widget:
                    id: ball
                    size: dp(80), dp(80)
                    canvas:
                        Color:
                            rgba: 0.4, 0.9, 0.5, 1
                        Ellipse:
                            pos: self.pos
                            size: self.size
            Label:
                text: 'stopwatch {:05.2f}'.format(root.elapsed)
                font_size: '32sp'
                bold: True

<WidgetsScreen>:
    BoxLayout:
        orientation: 'vertical'
        canvas.before:
            Color:
                rgba: 0.1, 0.08, 0.07, 1
            Rectangle:
                pos: self.pos
                size: self.size
        Header:
            title: 'Widgets'
        BoxLayout:
            padding: dp(16)
            spacing: dp(16)
            BoxLayout:
                orientation: 'vertical'
                spacing: dp(10)
                Label:
                    text: 'Slider: {:.0f}'.format(slider.value)
                    size_hint_y: None
                    height: dp(30)
                Slider:
                    id: slider
                    min: 0
                    max: 100
                    value: 40
                    size_hint_y: None
                    height: dp(40)
                Widget:
                    size_hint_y: None
                    height: dp(24)
                    canvas:
                        Color:
                            rgba: 0.3, 0.3, 0.35, 1
                        Rectangle:
                            pos: self.pos
                            size: self.size
                        Color:
                            rgba: 1, 0.6, 0.2, 1
                        Rectangle:
                            pos: self.pos
                            size: self.width * slider.value / 100., self.height
                BoxLayout:
                    size_hint_y: None
                    height: dp(40)
                    Label:
                        text: 'Switch: ' + ('on' if switch.active else 'off')
                    Switch:
                        id: switch
                        active: True
                BoxLayout:
                    size_hint_y: None
                    height: dp(40)
                    spacing: dp(6)
                    ToggleButton:
                        text: 'Left'
                        group: 'align'
                        state: 'down'
                    ToggleButton:
                        text: 'Center'
                        group: 'align'
                    ToggleButton:
                        text: 'Right'
                        group: 'align'
                BoxLayout:
                    size_hint_y: None
                    height: dp(40)
                    CheckBox:
                        active: True
                    Label:
                        text: 'Check one'
                    CheckBox:
                    Label:
                        text: 'Check two'
                Spinner:
                    text: 'Spinner'
                    values: 'Vulkan', 'Metal', 'OpenGL ES', 'WebGPU'
                    size_hint_y: None
                    height: dp(44)
                Widget:
            ScrollView:
                do_scroll_x: False
                GridLayout:
                    id: rows
                    cols: 1
                    spacing: dp(4)
                    size_hint_y: None
                    height: self.minimum_height

<ShaderScreen>:
    BoxLayout:
        orientation: 'vertical'
        Header:
            title: 'Shader'
        PlasmaView:
            id: plasma
